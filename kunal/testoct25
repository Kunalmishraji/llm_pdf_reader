import sqlite3

db_path = '/content/searches_input.db'
conn = sqlite3.connect(db_path)
cursor = conn.cursor()

query_tables = "SELECT name FROM sqlite_master WHERE type='table';"
cursor.execute(query_tables)
tables = cursor.fetchall()

schemas = {}
for table in tables:
    table_name = table[0]
    query_schema = f"PRAGMA table_info('{table_name}');"
    cursor.execute(query_schema)
    schema_info = cursor.fetchall()
    schemas[table_name] = schema_info

conn.close()

for table_name, schema in schemas.items():
    print(f"Schema for table '{table_name}':")
    for col_info in schema:
        print(f"  Column Name: {col_info[1]}, Data Type: {col_info[2]}")

documents = []
documents.extend(text_chunks)

for table_name, schema in schemas.items():
    schema_string = f"Table: {table_name}, Schema: "
    for col_info in schema:
        schema_string += f"Column Name: {col_info[1]}, Data Type: {col_info[2]}; "
    documents.append(schema_string)

print(f"Total number of documents: {len(documents)}")

from sentence_transformers import SentenceTransformer

