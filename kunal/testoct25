from langchain_google_genai import ChatGoogleGenerativeAI
from langchain_core.messages import HumanMessage

gemini_llm = ChatGoogleGenerativeAI(model="gemini-2.5-flash", temperature=0)

class GeminiWrapper:
    def __init__(self, model):
        self.model = model

    def __call__(self, prompt: str) -> str:
        # Wrap the prompt in a HumanMessage and pass it as a list of lists
        message = HumanMessage(content=prompt)
        response = self.model.generate([[message]]) # Pass as list of lists
        # Extract text from first generation
        return response.generations[0][0].text

gemini_llm = GeminiWrapper(gemini_llm)

def query_agent(query: str) -> str:
    if "table" in query.lower() or "schema" in query.lower():
        context = faiss_tool_fn(query)
        prompt = f"Use the following context to answer the question:\n\n{context}\n\nQuestion: {query}"
    else:
        prompt = query

    # Gemini LLM from langchain-community can be called directly with a string
    response = gemini_llm(prompt)
    return response

query = "what is level_1_logic"
faiss_tool_fn(query)
result = query_agent(query)
print("Agent Response:")
print(result)
